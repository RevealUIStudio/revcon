# OS
.DS_Store
Thumbs.db

# Session/runtime data
*.log
*.local

# Local client / prospect pattern list for scripts/check-client-leaks.sh.
# CI does not read this file. It uses the CLIENT_LEAK_PATTERNS org secret.
.client-name-watchlist.local

# Claude Code per-developer state (settings.local.json, session caches,
# worktrees). Materialized rules/agents/skills are tracked (GAP-372 copy-mode);
# keep local state ignored so it cannot bypass the Private Leak Scan gate.
.claude/*
!.claude/rules/
!.claude/agents/
!.claude/skills/
!.claude/.revcon-manifest.json
