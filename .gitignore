# OS
.DS_Store
Thumbs.db

# Session/runtime data
*.log
*.local

# Claude Code per-developer state (settings.local.json, session caches,
# worktrees). Materialized rules/agents/skills are tracked (GAP-372 copy-mode);
# keep local state ignored so it cannot bypass the Private Leak Scan gate.
.claude/*
!.claude/rules/
!.claude/agents/
!.claude/skills/
!.claude/.revcon-manifest.json
!.claude/.generated-from

# Native policy is the source. Vendor projections are generated from it.
.revealui/*
!.revealui/content/
!.revealui/.revcon-manifest.json

.grok/*
!.grok/rules/
!.grok/agents/
!.grok/skills/
!.grok/commands/
!.grok/.generated-from
!.grok/.revcon-manifest.json
